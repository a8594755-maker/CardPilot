"""Vectorized HUNL game state for AlphaHoldem training.

Maintains N parallel poker games in flat numpy arrays so the entire batch can be
advanced in lockstep. The whole point is to keep inference batches large by
having all parallel games hit a decision point at the same time.

State layout (per parallel game):
  pot              float32   pot size in BB
  stacks (2)       float32   remaining stack per player
  street           int8      0=PRE 1=FLOP 2=TURN 3=RIVER 4=SHOWDOWN
  current_player   int8      0 or 1
  hero_player      int8      0 or 1  (alternates each hand to balance positions)
  folded_player    int8      -1 = no fold
  is_done          bool      terminal flag
  street_committed (2)       chips committed this street
  raise_count      int8      raises this street
  num_actions      int8      actions this street
  holes (2,2)      int8      hole cards 0..51
  board (5)        int8      community cards (-1 if not dealt)
  deck (52)        int8      shuffled deck
  deck_pos         int8      next card to deal
  action_hist (MAX_ACT, 3)   per-action (player, type, amount*100 int)
  hist_len         int16     number of actions in history

We use numpy for state; obs encoding loops in Python per-game (cheap relative
to inference). The big win is that inference batches are now N (e.g. 1024),
not 5 like the worker-multiprocess trainer.
"""
from __future__ import annotations

import os
import sys
import math
import numpy as np

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
from deep_cfr.game_state import ActionType, Street
from deep_cfr.hand_eval import compare_hands

# ─── Constants ──────────────────────────────────────────────────────────────
NUM_ACTIONS = 9
RAISE_FRACTIONS = np.array([0.33, 0.50, 0.67, 0.75, 1.00, 1.50], dtype=np.float32)
PREFLOP_RAISE_FRACTIONS = np.array([0.50, 1.00, 1.50], dtype=np.float32)
MAX_ACTIONS_PER_STREET = 6
NUM_STREETS = 4
MAX_HIST = MAX_ACTIONS_PER_STREET * NUM_STREETS  # 24

# Action types as ints (match deep_cfr.game_state.ActionType)
A_FOLD = int(ActionType.FOLD)     # 0
A_CHECK = int(ActionType.CHECK)   # 1
A_CALL = int(ActionType.CALL)     # 2
A_BET = int(ActionType.BET)       # 3
A_RAISE = int(ActionType.RAISE)   # 4
A_ALLIN = int(ActionType.ALLIN)   # 5

# Streets
S_PRE = 0
S_FLOP = 1
S_TURN = 2
S_RIVER = 3
S_SHOWDOWN = 4


class VecHUNLState:
    """Batched HU NL Hold'em state for N parallel games.

    All operations are O(N) vectorized numpy ops, except hand evaluation at
    showdown which iterates over terminal games via a Python loop calling treys
    (which is fast: ~0.05ms per call). At training speed this is negligible.
    """

    def __init__(self, N: int, effective_stack: float = 200.0,
                 starting_pot: float = 1.5, sb: float = 0.5, bb: float = 1.0,
                 raise_cap_preflop: int = 4, raise_cap_postflop: int = 1,
                 seed: int | None = None):
        self.N = int(N)
        self.eff_stack = float(effective_stack)
        self.starting_pot = float(starting_pot)
        self.sb = float(sb)
        self.bb = float(bb)
        self.raise_cap_pre = int(raise_cap_preflop)
        self.raise_cap_post = int(raise_cap_postflop)
        self.rng = np.random.default_rng(seed)

        # Allocate state arrays
        N = self.N
        self.pot = np.zeros(N, dtype=np.float32)
        self.stacks = np.zeros((N, 2), dtype=np.float32)
        self.street = np.zeros(N, dtype=np.int8)
        self.current_player = np.zeros(N, dtype=np.int8)
        self.hero_player = np.zeros(N, dtype=np.int8)
        self.folded_player = np.full(N, -1, dtype=np.int8)
        self.is_done = np.zeros(N, dtype=bool)
        self.street_committed = np.zeros((N, 2), dtype=np.float32)
        self.raise_count = np.zeros(N, dtype=np.int8)
        self.num_actions = np.zeros(N, dtype=np.int8)
        self.holes = np.full((N, 2, 2), -1, dtype=np.int8)
        self.board = np.full((N, 5), -1, dtype=np.int8)
        self.deck = np.zeros((N, 52), dtype=np.int8)
        self.deck_pos = np.zeros(N, dtype=np.int8)
        self.action_hist = np.zeros((N, MAX_HIST, 3), dtype=np.int16)
        self.hist_len = np.zeros(N, dtype=np.int16)
        # last_bet_size is in units of street_committed (i.e. the new street_committed of bettor)
        self.last_bet_size = np.zeros(N, dtype=np.float32)
        # Total chips committed across the whole hand (for trinal-clip bounds)
        # = eff_stack - stacks[player]  but cache for terminal payoff calculation
        # We'll compute it on demand.

        self.hand_idx = np.zeros(N, dtype=np.int64)  # how many hands completed per slot

    # ── Reset ───────────────────────────────────────────────────────────────
    def reset_all(self):
        """Initialize all N games to start of a fresh hand."""
        # Shuffle decks: for each game, draw a random permutation of 0..51
        base = np.arange(52, dtype=np.int8)
        for i in range(self.N):
            self.deck[i] = self.rng.permutation(base)
        self.deck_pos[:] = 0
        self.holes[:] = -1
        self.board[:] = -1
        self.is_done[:] = False
        self.folded_player[:] = -1
        self.hist_len[:] = 0
        self.action_hist[:] = 0
        self.raise_count[:] = 0
        self.num_actions[:] = 0
        # Hero player alternates: even hand_idx → player 0, odd → player 1
        self.hero_player[:] = (self.hand_idx % 2).astype(np.int8)
        # Initial state (preflop)
        # Player 0 = BB (posts 1.0), Player 1 = SB (posts 0.5); SB acts first.
        self.pot[:] = self.starting_pot
        self.stacks[:, 0] = self.eff_stack - self.bb
        self.stacks[:, 1] = self.eff_stack - self.sb
        self.street[:] = S_PRE
        self.current_player[:] = 1  # SB acts first preflop
        self.street_committed[:, 0] = self.bb
        self.street_committed[:, 1] = self.sb
        self.last_bet_size[:] = self.bb  # opening BB defines the "bet to beat"
        # Deal hole cards
        for i in range(self.N):
            self.holes[i, 0, 0] = self.deck[i, 0]
            self.holes[i, 0, 1] = self.deck[i, 1]
            self.holes[i, 1, 0] = self.deck[i, 2]
            self.holes[i, 1, 1] = self.deck[i, 3]
        self.deck_pos[:] = 4

    def reset_done(self):
        """Reset only games where is_done=True. Increment hand_idx for those."""
        done = self.is_done.copy()
        if not done.any():
            return
        idx = np.where(done)[0]
        # Increment hand_idx for finished games
        self.hand_idx[idx] += 1
        # Shuffle decks for those games
        base = np.arange(52, dtype=np.int8)
        for i in idx:
            self.deck[i] = self.rng.permutation(base)
        # Reset everything for those rows
        self.deck_pos[idx] = 0
        self.holes[idx] = -1
        self.board[idx] = -1
        self.is_done[idx] = False
        self.folded_player[idx] = -1
        self.hist_len[idx] = 0
        self.action_hist[idx] = 0
        self.raise_count[idx] = 0
        self.num_actions[idx] = 0
        self.hero_player[idx] = (self.hand_idx[idx] % 2).astype(np.int8)
        self.pot[idx] = self.starting_pot
        self.stacks[idx, 0] = self.eff_stack - self.bb
        self.stacks[idx, 1] = self.eff_stack - self.sb
        self.street[idx] = S_PRE
        self.current_player[idx] = 1
        self.street_committed[idx, 0] = self.bb
        self.street_committed[idx, 1] = self.sb
        self.last_bet_size[idx] = self.bb
        for i in idx:
            self.holes[i, 0, 0] = self.deck[i, 0]
            self.holes[i, 0, 1] = self.deck[i, 1]
            self.holes[i, 1, 0] = self.deck[i, 2]
            self.holes[i, 1, 1] = self.deck[i, 3]
        self.deck_pos[idx] = 4

    # ── Helpers ─────────────────────────────────────────────────────────────
    def to_call(self) -> np.ndarray:
        """Amount to call per game from current player's perspective. (N,)"""
        cp = self.current_player.astype(np.int64)
        opp = 1 - cp
        rows = np.arange(self.N)
        return np.maximum(0.0,
                          self.street_committed[rows, opp] -
                          self.street_committed[rows, cp])

    def cur_stack(self) -> np.ndarray:
        """Current player's stack. (N,)"""
        rows = np.arange(self.N)
        return self.stacks[rows, self.current_player.astype(np.int64)]

    def cur_committed(self) -> np.ndarray:
        """Current player's chips committed this street. (N,)"""
        rows = np.arange(self.N)
        return self.street_committed[rows, self.current_player.astype(np.int64)]

    # ── Legal action mask (9 slots) ─────────────────────────────────────────
    # Matches deep_cfr/alpha_holdem.environment.get_legal_mask exactly:
    # postflop fractions [0.33,0.50,0.67,0.75,1.00,1.50] → slots [2,3,4,5,6,7]
    # preflop  fractions [0.50, 1.00, 1.50]              → slots [3, 6, 7]
    # Slots 2,4,5 must be MASKED in preflop (V4 was trained without those).
    PREFLOP_LEGAL_RAISE_SLOTS = (3, 6, 7)
    POSTFLOP_LEGAL_RAISE_SLOTS = (2, 3, 4, 5, 6, 7)

    def legal_mask(self) -> np.ndarray:
        """(N, 9) float32 — 1.0 if action slot is legal in that game.

        Matches the Python reference encoder exactly: in preflop, only 3 raise
        slots (3, 6, 7) are legal; in postflop, all 6 raise slots (2-7) are.
        """
        mask = np.zeros((self.N, NUM_ACTIONS), dtype=np.float32)
        alive = ~self.is_done

        to_call = self.to_call()
        stack = self.cur_stack()
        is_preflop = (self.street == S_PRE)
        cap = np.where(is_preflop, self.raise_cap_pre, self.raise_cap_post)
        can_raise = (self.raise_count < cap) & (stack > to_call) & alive

        # Slot 1: check/call always legal if alive
        mask[alive, 1] = 1.0

        # Slot 0: fold legal iff facing a bet
        facing = (to_call > 0) & alive
        mask[facing, 0] = 1.0

        # Raise slots — preflop vs postflop only allow specific subsets
        pre_raisable = can_raise & is_preflop
        post_raisable = can_raise & ~is_preflop
        for s in self.PREFLOP_LEGAL_RAISE_SLOTS:
            mask[pre_raisable, s] = 1.0
        for s in self.POSTFLOP_LEGAL_RAISE_SLOTS:
            mask[post_raisable, s] = 1.0

        # All-in (slot 8): legal iff alive and stack > 0 and (stack > to_call or no bet)
        allin_ok = alive & (stack > 0) & ((stack > to_call) | (to_call <= 0))
        mask[allin_ok, 8] = 1.0

        # If facing all-in (to_call >= stack), only fold/call legal
        forced = facing & (to_call >= stack)
        mask[forced, 2:] = 0.0

        return mask

    # ── Apply a batch of 9-slot actions ─────────────────────────────────────
    def step(self, actions: np.ndarray):
        """Apply a 9-slot action to each parallel game.

        `actions` is (N,) int. Games where is_done=True are skipped.
        """
        actions = actions.astype(np.int64)
        cp = self.current_player.astype(np.int64)
        rows = np.arange(self.N)
        alive = ~self.is_done
        to_call = self.to_call()
        stack = self.cur_stack()
        committed = self.cur_committed()
        pot = self.pot.copy()
        is_pre = (self.street == S_PRE)

        # --- 1. Compute the per-row action effect: type + amount-to ---
        # We'll compute three outputs:
        #   a_type   (N,)  ActionType int (fold/check/call/bet/raise/allin)
        #   a_to     (N,)  total chips committed to this street after action
        #   a_delta  (N,)  additional chips moved into pot
        a_type = np.zeros(self.N, dtype=np.int8)
        a_to = np.zeros(self.N, dtype=np.float32)
        a_delta = np.zeros(self.N, dtype=np.float32)

        # --- Slot 0: FOLD ---
        m = alive & (actions == 0)
        a_type[m] = A_FOLD

        # --- Slot 1: CHECK or CALL ---
        m = alive & (actions == 1)
        m_check = m & (to_call <= 1e-6)
        m_call = m & ~m_check
        a_type[m_check] = A_CHECK
        a_type[m_call] = A_CALL
        call_amt = np.minimum(to_call[m_call], stack[m_call])
        a_to[m_call] = committed[m_call] + call_amt
        a_delta[m_call] = call_amt

        # --- Slot 8: ALLIN ---
        m = alive & (actions == 8) & (stack > 0)
        a_type[m] = A_ALLIN
        a_to[m] = committed[m] + stack[m]
        a_delta[m] = stack[m]

        # --- Slots 2-7: BET or RAISE ---
        # Slot -> fraction:
        #   postflop slots 2..7 -> [0.33, 0.50, 0.67, 0.75, 1.00, 1.50] (RAISE_FRACTIONS)
        #   preflop  slots 3,6,7 -> [0.50, 1.00, 1.50]; other preflop slots remain MASKED.
        # We still compute for all 6 slot indices to keep code simple — if the
        # network ever fires a "shouldn't-be-legal" slot (e.g. preflop slot 2),
        # the bet size used is the postflop fraction, which won't match Python.
        # The legal-mask filter prevents this in practice.
        preflop_slot_to_frac = {3: 0.50, 6: 1.00, 7: 1.50}
        for slot_i in range(6):
            slot = 2 + slot_i
            m = alive & (actions == slot)
            if not m.any():
                continue
            post_frac = RAISE_FRACTIONS[slot_i]
            # Per-row: preflop uses the slot-specific preflop frac (only 3/6/7 used);
            # for unmapped preflop slots we fall back to post_frac, but mask blocks those.
            pf_frac_val = preflop_slot_to_frac.get(slot, post_frac)
            frac = np.where(is_pre[m], pf_frac_val, post_frac)
            pac = pot[m] + to_call[m]  # pot after call
            no_bet = (to_call[m] <= 1e-6)
            bet_size = np.where(no_bet, pot[m] * frac, to_call[m] + pac * frac)
            new_to = committed[m] + bet_size
            new_to = np.minimum(new_to, committed[m] + stack[m])
            delta = new_to - committed[m]
            t = np.where(delta >= stack[m] - 1e-6,
                         A_ALLIN,
                         np.where(no_bet, A_BET, A_RAISE)).astype(np.int8)
            a_type[m] = t
            a_to[m] = new_to
            a_delta[m] = delta

        # --- 2. Apply ledger updates ---
        m = alive & (a_type == A_FOLD)
        if m.any():
            self.folded_player[m] = cp[m].astype(np.int8)
            self.is_done[m] = True
            self._record_history(m, a_type, a_to)

        m = alive & ~self.is_done & (a_type != A_FOLD)
        if m.any():
            # Update stacks, street_committed, pot
            self.stacks[m, cp[m]] -= a_delta[m]
            self.street_committed[m, cp[m]] = a_to[m]
            self.pot[m] += a_delta[m]
            self._record_history(m, a_type, a_to)
            self.num_actions[m] += 1

            # Update raise count if BET/RAISE/ALLIN as opening or reraise
            is_bet_or_raise = np.isin(a_type[m], [A_BET, A_RAISE, A_ALLIN])
            rc_inc_mask = m.copy()
            rc_inc_mask[m] = is_bet_or_raise & (a_delta[m] > 0)
            self.raise_count[rc_inc_mask] += 1
            self.last_bet_size[rc_inc_mask] = self.street_committed[
                rc_inc_mask, cp[rc_inc_mask]
            ]

            # Switch current player to opponent
            self.current_player[m] = (1 - cp[m]).astype(np.int8)

            # Check for street advance: CHECK/CALL closes the street when num_actions >= 2
            # OR an all-in caps it.
            close_via_passive = m.copy()
            close_via_passive[m] = (
                np.isin(a_type[m], [A_CHECK, A_CALL]) & (self.num_actions[m] >= 2)
            )
            # All-in cases (either side is now broke)
            allin_done = m & ((self.stacks[:, 0] <= 1e-6) | (self.stacks[:, 1] <= 1e-6))
            close_mask = close_via_passive | allin_done
            if close_mask.any():
                self._advance_street(close_mask, allin_done)

    def _record_history(self, mask: np.ndarray, a_type: np.ndarray, a_to: np.ndarray):
        """Write (player, type, amount*100) into action_hist for rows in mask.

        IMPORTANT: matches deep_cfr.game_state.Action.amount semantics:
          - FOLD / CHECK / CALL: amount = 0
          - BET / RAISE / ALLIN: amount = total committed to this street after action
        This is what encode_action_history reads for the amount-fraction channel.
        """
        idx = np.where(mask)[0]
        for i in idx:
            slot = self.hist_len[i]
            if slot >= MAX_HIST:
                continue
            t = int(a_type[i])
            self.action_hist[i, slot, 0] = self.current_player[i]
            self.action_hist[i, slot, 1] = t
            if t in (A_FOLD, A_CHECK, A_CALL):
                self.action_hist[i, slot, 2] = 0
            else:
                self.action_hist[i, slot, 2] = int(a_to[i] * 100)
            self.hist_len[i] = slot + 1

    def _advance_street(self, close_mask: np.ndarray, allin_done: np.ndarray):
        """Move close_mask rows to the next street, deal cards, reset betting."""
        idx = np.where(close_mask)[0]
        for i in idx:
            if self.is_done[i]:
                continue
            if allin_done[i] and not self.is_done[i]:
                # Run out remaining board, mark done as showdown
                self._run_out_board(i)
                self.street[i] = S_SHOWDOWN
                self.is_done[i] = True
                continue
            cur = self.street[i]
            if cur == S_PRE:
                self.street[i] = S_FLOP
                self._deal(i, 3)
            elif cur == S_FLOP:
                self.street[i] = S_TURN
                self._deal(i, 1)
            elif cur == S_TURN:
                self.street[i] = S_RIVER
                self._deal(i, 1)
            elif cur == S_RIVER:
                self.street[i] = S_SHOWDOWN
                self.is_done[i] = True
                continue
            # Reset street-level betting
            self.street_committed[i, :] = 0.0
            self.raise_count[i] = 0
            self.num_actions[i] = 0
            self.current_player[i] = 0  # OOP acts first postflop
            self.last_bet_size[i] = 0.0

    def _deal(self, i: int, n: int):
        for _ in range(n):
            pos = self.deck_pos[i]
            if pos >= 52:
                break
            # find first empty slot in board
            for j in range(5):
                if self.board[i, j] < 0:
                    self.board[i, j] = self.deck[i, pos]
                    break
            self.deck_pos[i] = pos + 1

    def _run_out_board(self, i: int):
        # Fill remaining board slots
        while True:
            empty = -1
            for j in range(5):
                if self.board[i, j] < 0:
                    empty = j
                    break
            if empty < 0:
                return
            pos = self.deck_pos[i]
            if pos >= 52:
                return
            self.board[i, empty] = self.deck[i, pos]
            self.deck_pos[i] = pos + 1

    # ── Terminal payoffs ────────────────────────────────────────────────────
    def terminal_rewards(self) -> np.ndarray:
        """Compute payoff for the HERO of each terminal game. (N,) float32.
        Returns 0 for non-terminal games.
        """
        rewards = np.zeros(self.N, dtype=np.float32)
        # Total invested by each player = eff_stack - stack
        invested = self.eff_stack - self.stacks  # (N, 2)

        # 1. Folds: the fold loser loses their invested chips; winner gets opponent's invested
        fm = self.is_done & (self.folded_player >= 0)
        if fm.any():
            loser = self.folded_player[fm].astype(np.int64)
            winner = 1 - loser
            rows = np.where(fm)[0]
            hero = self.hero_player[fm].astype(np.int64)
            # Hero is winner → +invested[loser]; hero is loser → -invested[hero]
            hero_is_loser = (hero == loser)
            hero_reward = np.where(
                hero_is_loser,
                -invested[rows, hero],
                invested[rows, 1 - hero],
            )
            rewards[fm] = hero_reward

        # 2. Showdown: call treys to compare hole cards on board
        sm = self.is_done & (self.folded_player < 0)
        if sm.any():
            for i in np.where(sm)[0]:
                h0 = (int(self.holes[i, 0, 0]), int(self.holes[i, 0, 1]))
                h1 = (int(self.holes[i, 1, 0]), int(self.holes[i, 1, 1]))
                board = [int(c) for c in self.board[i] if c >= 0]
                cmp = compare_hands(h0, h1, board)
                hero = int(self.hero_player[i])
                if cmp == 0:
                    rewards[i] = 0.0  # split pot
                elif cmp > 0:
                    rewards[i] = invested[i, 1] if hero == 0 else -invested[i, 0]
                else:
                    rewards[i] = -invested[i, 1] if hero == 0 else invested[i, 0]
        return rewards


__all__ = ['VecHUNLState', 'NUM_ACTIONS', 'MAX_HIST', 'RAISE_FRACTIONS', 'PREFLOP_RAISE_FRACTIONS']
